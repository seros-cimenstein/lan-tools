[Unit]
Description=lanclip - LAN universal clipboard
After=network-online.target graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/python3 %h/.local/lib/lanclip/lanclip.py
Restart=on-failure
RestartSec=5
# Fallback for desktops that never activate graphical-session.target:
# switch [Install] to WantedBy=default.target and set the session env here.
# X11 hosts:
#Environment=DISPLAY=:0
#Environment=XAUTHORITY=%h/.Xauthority
# Wayland hosts:
#Environment=WAYLAND_DISPLAY=wayland-1
#Environment=XDG_RUNTIME_DIR=/run/user/1000

[Install]
WantedBy=graphical-session.target
